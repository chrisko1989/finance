# Vorlage für einen dauerhaft verfügbaren Linux-Rechner; nicht installiert.
# User, WorkingDirectory, Interpreter und Datenpfad vor Verwendung anpassen.
[Unit]
Description=Depotblick Tageschecks und Wochenberichte
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=DEPOTBLICK_USER
WorkingDirectory=/ABSOLUTER/PFAD/finance
ExecStart=/usr/bin/python3 -m finance.monitor --daemon --data-dir /ABSOLUTER/PFAD/finance/.data
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/ABSOLUTER/PFAD/finance/.data

[Install]
WantedBy=multi-user.target
